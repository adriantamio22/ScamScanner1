{
  "entities": {
    "CaseRecord": {
      "title": "Case Record",
      "description": "A saved forensic scan result.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["LOOKUP", "EMAIL", "IP", "WEBSITE", "EML"] },
        "input": { "type": "string" },
        "verdict": { "type": "string", "enum": ["MALICIOUS_THREAT", "SUSPICIOUS_ACTIVITY", "LEGIT_SIGNAL"] },
        "legitimacyPercentage": { "type": "number" },
        "executiveSummary": { "type": "string" },
        "forensicSignals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO"] },
              "description": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "type", "input", "verdict", "legitimacyPercentage", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/cases/{caseId}": {
      "schema": "CaseRecord",
      "description": "User-specific forensic case history. Max input size: 64KB. Max summary: 10KB. Max signals: 128."
    }
  }
}
